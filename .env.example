# Required production secrets; leave no defaults. This file is not loaded by Java itself.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
# Absolute directory with a certificate valid for the service domain:
TLS_CERT_DIR=
# Optional, only for an empty users table; remove after first successful startup:
TCP_BOOTSTRAP_USERNAME=
TCP_BOOTSTRAP_PASSWORD=
AUTH_SESSION_TTL_SECONDS=28800

# Optional server-side Kakao transit key. Never give this secret a VITE_ prefix.
KAKAO_REST_API_KEY=
